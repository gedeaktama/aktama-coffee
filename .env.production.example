APP_NAME="Aktama Coffee"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://aktama.com/coffee

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Konfigurasi Database cPanel / Niagahoster / Shared Hosting
# Catatan: Di hosting cPanel, nama database dan user biasanya diawali prefix username cPanel.
# Contoh: u107454400_coffee_prod dan u107454400_coffee_user
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=u107454400_coffee
DB_USERNAME=u107454400_coffeeuser
DB_PASSWORD=GantiDenganPasswordDatabaseKuat123!

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_SECURE_COOKIE=true

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mail.domain-anda.com
MAIL_PORT=465
MAIL_USERNAME=order@domain-anda.com
MAIL_PASSWORD=PasswordEmailHostAnda
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="order@domain-anda.com"
MAIL_FROM_NAME="${APP_NAME}"
